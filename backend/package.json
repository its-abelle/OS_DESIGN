{
    "name": "backend",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "imports": {
        "#*": "./src/*"
    },
    "scripts": {
        "start": "node src/index.ts",
        "test": "node --env-file=../.env --test test/*.test.ts",
        "test:auth": "node --test test/auth.test.ts",
        "test:files": "node --test test/files.test.ts",
        "db:init": "node scripts/init-database.ts",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3",
        "@aws-sdk/s3-request-presigner": "^3",
        "bcrypt": "^6.0.0",
        "connect-pg-simple": "^10.0.0",
        "express": "^5",
        "express-session": "^1.18.2",
        "multer": "^2",
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/bcrypt": "^6.0.0",
        "@types/connect-pg-simple": "^7.0.3",
        "@types/express-session": "^1.18.2",
        "@types/multer": "^2.3.0",
        "@types/node": "^26.6.6",
        "@types/pg": "^8.15.5",
        "typescript": "^7.0.2"
    }
}
