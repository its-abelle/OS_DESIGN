#cloud-config
package_update: true
packages:
  - docker.io
  - docker-compose-v2
  - git
  - openssl
  - curl
write_files:
  - path: /usr/local/sbin/setup-department-files
    owner: root:root
    permissions: '0700'
    encoding: b64
    content: ${bootstrap}
runcmd:
  - [bash, /usr/local/sbin/setup-department-files]
