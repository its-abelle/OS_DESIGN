MYSQL_HOST=database
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=replace_with_a_random_application_password
MYSQL_DATABASE=appdb
MYSQL_ROOT_PASSWORD=replace_with_a_different_random_root_password
# Use true only when the browser accesses the application over HTTPS.
SESSION_COOKIE_SECURE=false

# S3-compatible object storage (MinIO locally).
AWS_REGION=us-east-1
S3_BUCKET_NAME=documents
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=replace_with_a_random_storage_password
S3_ENDPOINT=http://minio:9000
# Set this to http://<Ubuntu-IP>:9100 for browsers on another computer or outside a VM.
S3_PUBLIC_ENDPOINT=http://localhost:9100
MAX_UPLOAD_MB=10
