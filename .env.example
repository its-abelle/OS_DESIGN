POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=appdb
DATABASE_URL=postgres://app:change_me@database:5432/appdb
SESSION_SECRET=change_me_long_random

# S3 (MinIO). For real AWS: drop S3_ENDPOINT/S3_PUBLIC_ENDPOINT, set real keys + region.
AWS_REGION=us-east-1
S3_BUCKET_NAME=documents
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me_min8chars
S3_ENDPOINT=http://minio:9000
# URL the BROWSER uses for presigned downloads
S3_PUBLIC_ENDPOINT=http://localhost:9100
MAX_UPLOAD_MB=10
